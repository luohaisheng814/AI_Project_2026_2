<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.busan.tour"
    android:versionCode="24"
    android:versionName="3.1">

    <!-- v3.1：追问建议区加「收起/展开」头部；新增后台管理（账号/内容/版本，默认 admin/admin），
         手机端每 25 秒轮询内容 rev，变了下发刷新提示；版本号变大时弹安装包更新层。
         v3.0：页头右上角新增昼夜切换按钮（🌓 自动 → ☀️ 白天 → 🌙 夜间 循环），
         手动选择记在本机（busan_theme），下次打开照旧；切换后给 1.8 秒一次性提示。
         自动模式下仍按手机本地时间走（06:00–18:59 白天 / 19:00–05:59 夜间），
         每 60 秒复判一次，切回前台也会复判。
         v2.9：个性化推荐（欢迎语里的 5 个点子）改成可收起/展开的一条——收起时只占一行标题，
         展开后单行横向滚动（含右侧渐隐提示），纵向从原来的三行压到一行；点任一点子会自动收起。
         同步把手动天气 chip 与「时间/天气/距离」三枚胶囊也改成单行横滑，减少卡内占地。
         v2.8：天气按钮与“附近”统一成一条链路——先问权限、再申请系统定位，取到坐标后按经纬度
         取当地天气，再结合手机本地时间（凌晨/上午/午间/午后/傍晚/夜间）排出此刻先去哪三个；
         结论卡用「时间 / 天气 / 距离」三枚胶囊交代依据，气泡第二行补上“几点 · 哪一段 · 最近景点”。
         v2.7：天气入口收到右上角一枚按钮——先问权限、再申请系统定位，取到后只露 10 秒短气泡，
         往上翻看旧内容/弹出面板/切后台就自动收起；页面按本地时间切昼夜（19:00–06:00 夜间）。
         v2.6：手机 UI 收口——平板/宽屏单列居中、触控目标与输入框
         字号按移动端规范校正（iOS 聚焦不再自动放大）、窄屏内边距收紧；新增 PWA 元信息、
         应用图标（180/192/512/1024）、manifest 与离线 service worker，iPhone 可直接
         “添加到主屏幕”安装同一套界面；欢迎语新增“今天天气适合去哪”入口。
         v2.5：手机端新增天气能力——授予定位后按经纬度读取实况天气（Open-Meteo，免 Key），
         按天气推荐更合适的景点；天气变化（转雨/降温/起风/降水概率上升）主动给建议；
         景点与玩法评级统一改成 5 星制（玩法/景观/便利/性价比四项 + 用户自评）；
         同时提供 iOS（WKWebView）壳工程与 CI，复用同一套 assets。
         v2.4：景点图片支持点按全屏查看——双指缩放、双击放大、单指拖动、左右切换。
         v2.3：完善手机版 UI——实时定位自动恢复与 15 秒无坐标提示；GPS 按钮统一走原生
         LocationManager；地图按钮明确标注 NAVER / Google 归属；景点回答上方增加
         1-3 张内置实景图（Wikimedia Commons，离线可用）。
         v2.2：修“去甘村文化村的路线有几条”被半日行程抢答——补甘村/看川别名，
         显式路线问句优先进入定位与实时路线；路线结果新增按直线距离的“最优建议”。
         v2.0：补釜山其他核心景点（海云台/广安里/太宗台/札嘎其/南浦洞/松岛/白浅滩/
         龙头山/海东龙宫寺/西面），路线从“只有甘川”改为任意收录景点；
         新增“当前位置去其他景点”3 个最近点路线、附近问答与通用智能建议。
         v1.9.1：修正 planner 把“有几条路线/怎么去/从当前位置去”误当成行程规划，
         这类句子必须先进入定位权限与实时路线流程。
         v1.9：路线问题先检查地图定位权限，未授权时在对话里申请；授权后读取实时坐标，
         汇总 NAVER 三类走法；意图解析继续用云端模型纠正错字并猜测真实需求。
         v1.8.1：云端意图解析、上午推荐、从实时定位到景点的 3 条走法。
         v1.8：取消端侧 379 MB 模型与原生库，改为联网自动连接免费云端模型（Kilo Gateway 匿名层，
         默认 NVIDIA Nemotron 3.5 Super VL 开放权重）；离线自动回退包内规则。 
         v1.7：顶部不常驻在线/离线控件；每条回答固定 3 个可选方案。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.NoTitleBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
