<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.busan.tour"
    android:versionCode="15"
    android:versionName="2.2">

    <!-- v2.2：修“去甘村文化村的路线有几条”被半日行程抢答——补甘村/看川别名，
         显式路线问句优先进入定位与实时路线；路线结果新增按直线距离的“最优建议”。
         v2.0：补釜山其他核心景点（海云台/广安里/太宗台/札嘎其/南浦洞/松岛/白浅滩/
         龙头山/海东龙宫寺/西面），路线从“只有甘川”改为任意收录景点；
         新增“当前位置去其他景点”3 个最近点路线、附近问答与通用智能建议。
         v1.9.1：修正 planner 把“有几条路线/怎么去/从当前位置去”误当成行程规划，
         这类句子必须先进入定位权限与实时路线流程。
         v1.9：路线问题先检查地图定位权限，未授权时在对话里申请；授权后读取实时坐标，
         汇总 NAVER 三类走法；意图解析继续用云端模型纠正错字并猜测真实需求。
         v1.8.1：云端意图解析、上午推荐、从实时定位到景点的 3 条走法。
         v1.8：取消端侧 379 MB 模型与原生库，改为联网自动连接免费云端模型（Kilo Gateway 匿名层，
         默认 NVIDIA Nemotron 3.5 Super VL 开放权重）；离线自动回退包内规则。 
         v1.7：顶部不常驻在线/离线控件；每条回答固定 3 个可选方案。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.NoTitleBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
